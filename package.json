{
  "name": "kanban-safe",
  "version": "0.2.0",
  "private": true,
  "description": "Servidor MCP de uso interno da MedSafe Brasil para o board Planka 1.x",
  "type": "module",
  "bin": {
    "kanban-safe": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
